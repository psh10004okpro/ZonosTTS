# Backend 환경 변수

# 서버 설정
HOST=0.0.0.0
PORT=8000
RELOAD=false

# 디바이스 설정 (cuda 또는 cpu)
DEVICE=cuda

# Zonos 모델 설정
ZONOS_MODEL=Zyphra/Zonos-v0.1-transformer
# 또는 Zyphra/Zonos-v0.1-hybrid

# 데이터베이스 (선택사항)
DATABASE_URL=sqlite+aiosqlite:///./zonos_tts.db

# 로깅
LOG_LEVEL=info

# 동시성 제어 (GPU 리소스 관리)
MAX_CONCURRENT_TTS=2           # 동시 TTS 생성 수
MAX_CONCURRENT_EMBEDDING=1      # 동시 임베딩 생성 수
MAX_QUEUE_SIZE=10               # 최대 대기 큐 크기
REQUEST_TIMEOUT=300.0           # 요청 타임아웃 (초)

# 캐싱 설정 (Redis)
REDIS_ENABLED=true              # Redis 캐싱 활성화
REDIS_HOST=localhost            # Redis 호스트
REDIS_PORT=6379                 # Redis 포트
REDIS_DB=0                      # Redis 데이터베이스 번호
REDIS_PASSWORD=                 # Redis 비밀번호 (옵션)

# 캐시 TTL (초)
CACHE_TTL_SPEAKER_EMBEDDING=86400    # 화자 임베딩 캐시 (24시간)
CACHE_TTL_TTS_RESULT=3600            # TTS 결과 캐시 (1시간)
CACHE_TTL_AUDIO_METADATA=1800        # 오디오 메타데이터 캐시 (30분)

# 캐시 크기 제한
MAX_CACHE_SIZE_MB=1024          # 최대 캐시 크기 (MB)
MAX_CACHED_EMBEDDINGS=100       # 최대 캐시된 임베딩 수
