# Backend Dockerfile (CPU only)
# For systems without NVIDIA GPU

FROM python:3.10-slim

# 환경 변수 설정
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# 시스템 패키지 설치
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    espeak-ng \
    ffmpeg \
    libsndfile1 \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# 작업 디렉토리 설정
WORKDIR /app

# Python 패키지 설치
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# CPU용 PyTorch 설치 (GPU 버전 덮어쓰기)
RUN pip install --no-cache-dir torch torchaudio --index-url https://download.pytorch.org/whl/cpu

# Zonos 설치
RUN pip install --no-cache-dir git+https://github.com/Zyphra/Zonos.git

# 애플리케이션 코드 복사
COPY . .

# 디렉토리 생성
RUN mkdir -p uploads/speakers uploads/generated uploads/embeddings logs data

# 실행 권한 부여
RUN chmod +x docker-entrypoint.sh

# 비root 사용자 생성 및 권한 설정
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app
USER appuser

# 포트 노출
EXPOSE 8000

# 헬스체크
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8000/api/system/health || exit 1

# 시작 스크립트
ENTRYPOINT ["./docker-entrypoint.sh"]
CMD ["uvicorn"]
